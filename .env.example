# ─── Required ───────────────────────────────────────────────────

# GEMINI_API_KEY: Gemini API key for the backend only.
# Production must inject this through Cloud Run Secret Manager, not the iOS app.
# Use a paid Gemini API project/key with billing enabled before App Store release.
GEMINI_API_KEY=""

# Firebase Admin uses Application Default Credentials (ADC) from the
# dedicated Cloud Run runtime service account. Do not add a credentials JSON
# path or a service-account private key to this environment file.
FIREBASE_PROJECT_ID="zhang23-23"

# Exact Firebase iOS App ID registered for よていスナップ.
FIREBASE_APP_ID=""

# Dedicated named Firestore database used only for extraction quotas.
FIRESTORE_DATABASE_ID="lifesnap-quota"

# INSTALLATION_HMAC_KEY must be a distinct Secret Manager value with at least
# 32 characters and must never reuse GEMINI_API_KEY.
INSTALLATION_HMAC_KEY=""

# ─── Optional ──────────────────────────────────────────────────

# GEMINI_MODEL: Model to use for image extraction (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# PORT: Server port (default: 8080)
PORT=8080

# MOCK_MODE: Set to "true" only in development to bypass Gemini API with mock data.
# The server refuses to start if MOCK_MODE=true and NODE_ENV=production.
MOCK_MODE="false"
