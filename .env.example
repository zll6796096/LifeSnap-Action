# ─── Required ───────────────────────────────────────────────────

# GEMINI_API_KEY: Google AI Studio API key for Gemini vision model.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Optional ──────────────────────────────────────────────────

# GEMINI_MODEL: Model to use for image extraction (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# PORT: Server port (default: 8080)
PORT=8080

# MOCK_MODE: Set to "true" in development to bypass Gemini API with mock data.
# Only works when NODE_ENV !== "production".
MOCK_MODE="false"
